---
import SectionLabel from '../components/SectionLabel.astro'
import { wedding } from '../data/wedding'
import { privateData } from '../data/private'

const p = privateData.phones

const people = [
  { label: `신랑 ${wedding.groom.name}`, phone: p.groom },
  { label: `신랑 아버지 ${wedding.groom.father.name}`, phone: p.groomFather,
    deceased: wedding.groom.father.deceased },
  { label: `신랑 어머니 ${wedding.groom.mother.name}`, phone: p.groomMother,
    deceased: wedding.groom.mother.deceased },
  { label: `신부 ${wedding.bride.name}`, phone: p.bride },
  { label: `신부 아버지 ${wedding.bride.father.name}`, phone: p.brideFather,
    deceased: wedding.bride.father.deceased },
  { label: `신부 어머니 ${wedding.bride.mother.name}`, phone: p.brideMother,
    deceased: wedding.bride.mother.deceased },
]

const chrysanthemum = (deceased?: boolean) => (deceased ? '菊 ' : '')

// 혼주 줄을 프론트매터에서 문자열로 조립한다. 템플릿에서 개행으로 나누면
// compressHTML:'jsx'가 개행 포함 공백을 통째로 지워 `홍판서 ·춘섬`처럼
// 가운뎃점 뒤 공백만 사라진다(실측). 여기서 만들면 공백이 문자열의 일부라 안전하다.
// `{mother.name}의`는 붙여 쓰는 것이 맞다 — 소유격 조사는 이름에 붙는다.
const parentLine = (side: typeof wedding.groom) =>
  `${chrysanthemum(side.father.deceased)}${side.father.name} · ` +
  `${chrysanthemum(side.mother.deceased)}${side.mother.name}의 ${side.order}`
---
<section class="shell py-14 reveal">
  <SectionLabel en="INVITATION" ko="모시는 말씀" />

  <p class="font-serif-kr text-center text-base leading-[2.1] whitespace-pre-line"
     style="color: var(--ink)">{wedding.greeting}</p>

  <div class="w-8 h-px mx-auto my-9" style="background: var(--line)"></div>

  <p class="text-center text-sm leading-loose">
    {parentLine(wedding.groom)} <strong style="color: var(--ink)">{wedding.groom.name}</strong>
    <br />
    {parentLine(wedding.bride)} <strong style="color: var(--ink)">{wedding.bride.name}</strong>
  </p>

  {/* 아코디언이 아니라 카드다. 연락처는 하객이 필요할 때 바로 눌러야 하는 것이라
      한 단계 펼치게 만들 이유가 없다. 제목은 이 섹션의 다른 요소와 맞춰 가운데 정렬. */}
  <div class="mt-8 border rounded-lg" style="border-color: var(--line)">
    <p class="text-center text-sm py-3">연락하기</p>
    {/* 고인이 된 혼주는 목록에서 뺀다. 남겨두면 조문하려던 하객이 전화 버튼을 눌러
        엉뚱한 사람에게 걸거나 없는 번호로 연결된다. 혼주 줄에는 菊과 함께 이름이
        그대로 남으므로 예를 갖추는 자리는 잃지 않는다.
        private.ts도 같은 플래그로 해당 전화번호 키를 필수에서 뺀다 — 유족이
        없는 번호를 지어내지 않아도 빌드가 통과한다. */}
    <ul class="px-4 pb-3">
      {people.filter((person) => !person.deceased).map((person) => (
        <li class="flex items-center justify-between gap-3 py-3 border-t"
            style="border-color: var(--line)">
          <span class="text-sm">{person.label}</span>
          <span class="flex gap-2">
            <a href={`tel:${person.phone}`}
               class="flex items-center px-3 rounded border text-xs"
               style="border-color: var(--line); color: var(--ink)"
               aria-label={`${person.label}에게 전화`}>전화</a>
            <a href={`sms:${person.phone}`}
               class="flex items-center px-3 rounded border text-xs"
               style="border-color: var(--line); color: var(--ink)"
               aria-label={`${person.label}에게 문자`}>문자</a>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
