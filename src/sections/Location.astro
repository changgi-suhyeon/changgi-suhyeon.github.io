---
import SectionLabel from '../components/SectionLabel.astro'
import Chevron from '../components/Chevron.astro'
import KakaoMap from '../components/KakaoMap'
import { wedding } from '../data/wedding'

const v = wedding.venue

// 빈 href는 깨진 링크를 보여주는 것보다 버튼을 안 그리는 게 낫다.
// trim()은 공백만 든 값(예: ' ')이 나중에 실수로 들어와도 truthy로 통과해
// 빈 버튼이 렌더되는 걸 막기 위함이다. 셋 다 값이 있으면 grid-cols-3이 된다.
const mapApps = [
  { name: '카카오맵', href: v.map.kakao },
  { name: '네이버지도', href: v.map.naver },
  { name: '티맵', href: v.map.tmap },
].filter((app) => app.href.trim())

// 남은 버튼 수에 맞춰 열 수를 맞춘다. grid-cols-3 그대로 두면 버튼 2개가
// 어색하게 늘어난다. (Tailwind JIT가 리터럴 클래스명을 스캔하므로
// grid-cols-3/grid-cols-2/grid-cols-1 문자열이 이 파일에 그대로 있어야 한다.)
const mapGridClass =
  mapApps.length === 3 ? 'grid-cols-3' : mapApps.length === 2 ? 'grid-cols-2' : 'grid-cols-1'

// 셋 다 비면 내용 없는 아코디언이 열린 채 보인다. 텍스트가 있는 항목만 렌더한다.
// 지금은 transit 값이 전부 비어 있어 accordions가 빈 배열이 되는 게 정상이다.
const accordions = [
  { title: '지하철 · 버스', text: [v.transit.subway, v.transit.bus].filter(Boolean).join('\n\n') },
  { title: '기차', text: [v.transit.train].filter(Boolean).join('\n\n') },
  { title: '자가용 · 주차', text: [v.transit.car, v.transit.parking].filter(Boolean).join('\n\n') },
].filter((item) => item.text.trim())
---
<section class="shell py-14 reveal">
  <SectionLabel en="LOCATION" ko="오시는 길" />

  {/* 줄 나눔은 데이터가 정한다(wedding.ts의 address / addressDetail 주석 참고).
      한 문자열로 두면 하이픈에서 끊겨 'L65'만 다음 줄에 홀로 남는데, CSS로는
      고칠 수 없는 자리다. */}
  <p class="text-center text-sm leading-loose">
    <strong style="color: var(--ink)">{v.name} {v.hall}</strong><br />
    {v.address}<br />
    {v.addressDetail}
  </p>

  {/* 인터랙티브 지도. 상자(비율·테두리)는 이 컴포넌트가 직접 갖는다 — 못 뜰 때
      스스로 렌더를 접어 빈 테두리를 남기지 않기 위해서다. 실패해도 아래 약도가
      길안내를 이어받으므로 이 영역이 사라져도 하객이 잃는 것이 없다. */}
  <KakaoMap lat={v.lat} lng={v.lng} label={v.name} client:visible />

  {mapApps.length > 0 && (
    <div class:list={['mt-3 grid gap-2', mapGridClass]}>
      {mapApps.map((app) => (
        <a href={app.href} target="_blank" rel="noopener noreferrer"
           class="flex items-center justify-center rounded border text-xs"
           style="border-color: var(--line); color: var(--ink)">{app.name}</a>
      ))}
    </div>
  )}

  {/* 식장 공식 약도. 출구 번호와 주차장 진입 방향이 표시돼 있어 일반 지도보다
      길안내가 직관적이다.

      <a>로 감싸 탭하면 원본이 열리게 한다. 원본이 3542x2488인데 폰에서는 342px 폭으로
      들어가 버스 번호와 출구 표시가 4px 수준이 된다 — 그냥 깔아두면 읽을 수 없다.
      브라우저 기본 이미지 뷰어는 핀치줌을 지원하므로 JS 없이 확대가 되고, 카카오톡
      인앱 브라우저에서도 동작한다. 라이트박스를 재사용하지 않는 이유이기도 하다. */}
  <a href={v.map.staticImage} target="_blank" rel="noopener noreferrer"
     class="mt-6 block rounded-lg border overflow-hidden"
     style="border-color: var(--line)"
     aria-label={`${v.name} 약도 원본 크기로 보기`}>
    <img src={v.map.staticImage} alt={`${v.name} 약도 — 지하철 출구와 주차장 진입 방향`}
         width="1440" height="1012" loading="lazy" decoding="async"
         class="w-full h-auto" />
  </a>
  <p class="mt-2 text-center text-xs" style="color: var(--muted)">
    약도를 탭하면 크게 볼 수 있어요
  </p>

  {accordions.length > 0 && (
    <div class="mt-6 space-y-2">
      {accordions.map((item) => (
        <details class="border rounded-lg" style="border-color: var(--line)">
          <summary class="flex items-center justify-between gap-2 px-4 text-sm cursor-pointer select-none">
            <span>{item.title}</span>
            <Chevron />
          </summary>
          <div class="px-4 pb-4 text-sm whitespace-pre-line">
            {item.text}
          </div>
        </details>
      ))}
    </div>
  )}

  {v.tel.trim() && (
    <a href={`tel:${v.tel}`}
       class="mt-4 flex items-center justify-center rounded border text-sm"
       style="border-color: var(--line); color: var(--ink)">
      식장에 전화하기
    </a>
  )}
</section>
