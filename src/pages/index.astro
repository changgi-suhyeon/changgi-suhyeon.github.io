---
import Base from '../layouts/Base.astro'
import Hero from '../sections/Hero.astro'
import Invitation from '../sections/Invitation.astro'
import WeddingDay from '../sections/WeddingDay.astro'
import Gallery from '../sections/Gallery.astro'
import Location from '../sections/Location.astro'
import Information from '../sections/Information.astro'
import Shuttle from '../sections/Shuttle.astro'
import Rsvp from '../sections/Rsvp.astro'
import Accounts from '../sections/Accounts.astro'
import { wedding } from '../data/wedding'
---
<Base title={`${wedding.groom.name} · ${wedding.bride.name} 결혼합니다`}>
  <main>
    <Hero />
    <Invitation />
    <WeddingDay />
    <Gallery />
    <Location />
    <Information />
    <Shuttle />
    <Rsvp />
    <Accounts />
  </main>
</Base>
